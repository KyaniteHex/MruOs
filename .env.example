# Local development needs no .env: without MONGODB_URI the API starts a
# temporary in-memory database (data is lost on restart) and a random
# session secret. Copy this file to .env to keep data between restarts.

PORT=3001
NODE_ENV=development

# Persistent database, e.g. a separate Atlas database for development:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/mruos-dev?retryWrites=true&w=majority
# At least 32 random characters, e.g. from `openssl rand -hex 32`:
# SESSION_SECRET=

# Only when the frontend runs on a different origin than the Vite proxy:
# WEB_ORIGIN=http://localhost:5173

# Required only with NODE_ENV=production (at least 32 characters); must match
# ORIGIN_SECRET of the Vercel environment that proxies to this API.
# ORIGIN_SECRET=
